#!/bin/sh

SNAPSHOT_READY=0
SNAPSHOT_APK=""
SNAPSHOT_APK_VERSIONS=""
SNAPSHOT_SERVICES=""
SNAPSHOT_PS=""
SNAPSHOT_IP_RULES=""
SNAPSHOT_IP_ROUTES=""
SNAPSHOT_UCI_PODKOP=""
SNAPSHOT_UCI_NETSHIFT=""
SNAPSHOT_PODKOP_ROUTING=0
SNAPSHOT_NETSHIFT_ROUTING=0
SNAPSHOT_NOW=0
SNAPSHOT_SSCLASH_SETTINGS=""
SNAPSHOT_SSCLASH_NFT=0

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

json_string() {
  printf '"%s"' "$(json_escape "$1")"
}

json_bool() {
  [ "$1" = "1" ] || [ "$1" = "true" ] && printf 'true' || printf 'false'
}

json_null_or_string() {
  [ -n "$1" ] && json_string "$1" || printf 'null'
}

json_number() {
  case "${1:-}" in
    ''|*[!0-9]*) printf '0' ;;
    *) printf '%s' "$1" ;;
  esac
}

collect_snapshot() {
  [ "$SNAPSHOT_READY" = "1" ] && return

  SNAPSHOT_NOW="$(date +%s 2>/dev/null || printf '0')"
  SNAPSHOT_APK="$(apk info 2>/dev/null || true)"
  SNAPSHOT_APK_VERSIONS="$(apk info -v 2>/dev/null || true)"
  SNAPSHOT_SERVICES="$(ubus call service list 2>/dev/null || true)"
  SNAPSHOT_PS="$(ps w 2>/dev/null || ps 2>/dev/null || true)"
  SNAPSHOT_IP_RULES="$(ip rule show 2>/dev/null || true)"
  SNAPSHOT_IP_ROUTES="$(ip route show table all 2>/dev/null || true)"
  SNAPSHOT_UCI_PODKOP="$(uci -q show podkop 2>/dev/null || true)"
  SNAPSHOT_UCI_NETSHIFT="$(uci -q show netshift 2>/dev/null || true)"
  SNAPSHOT_SSCLASH_SETTINGS="$(read_limited_file /opt/clash/settings)"

  if command -v nft >/dev/null 2>&1; then
    nft list table inet PodkopTable >/dev/null 2>&1 && SNAPSHOT_PODKOP_ROUTING=1
    nft list table inet NetShiftTable >/dev/null 2>&1 && SNAPSHOT_NETSHIFT_ROUTING=1
    nft list table inet netshift >/dev/null 2>&1 && SNAPSHOT_NETSHIFT_ROUTING=1
    nft list table inet clash >/dev/null 2>&1 && SNAPSHOT_SSCLASH_NFT=1
  fi

  printf '%s\n%s\n' "$SNAPSHOT_IP_RULES" "$SNAPSHOT_IP_ROUTES" | grep -Eiq 'netshift' && SNAPSHOT_NETSHIFT_ROUTING=1

  SNAPSHOT_READY=1
}

exists_path() {
  [ -e "$1" ]
}

package_installed() {
  collect_snapshot
  printf '%s\n' "$SNAPSHOT_APK" | grep -qx "$1"
}

package_any() {
  local name

  for name in "$@"; do
    package_installed "$name" && return 0
  done

  return 1
}

package_version() {
  local name="$1"

  collect_snapshot
  printf '%s\n' "$SNAPSHOT_APK_VERSIONS" | sed -n "s/^$name-//p" | head -n 1
}

first_package_version() {
  local name version

  for name in "$@"; do
    version="$(package_version "$name")"
    [ -n "$version" ] && {
      printf '%s' "$version"
      return
    }
  done
}

service_block() {
  local name="$1"

  collect_snapshot
  printf '%s\n' "$SNAPSHOT_SERVICES" | awk -v svc="$name" '
    $0 ~ "^[[:space:]]*\\{?[[:space:]]*\"" svc "\":[[:space:]]*\\{" { active = 1; depth = 0 }
    active {
      line = $0
      opens = gsub(/\{/, "{", line)
      line = $0
      closes = gsub(/\}/, "}", line)
      depth += opens - closes
      print
      if (depth <= 0) {
        exit
      }
    }
  '
}

service_running() {
  service_block "$1" | grep -q '"running"[[:space:]]*:[[:space:]]*true'
}

service_enabled() {
  local name="$1"

  [ -x "/etc/init.d/$name" ] && "/etc/init.d/$name" enabled >/dev/null 2>&1
}

process_running() {
  local pattern="$1"

  collect_snapshot
  printf '%s\n' "$SNAPSHOT_PS" | grep -Eq "$pattern"
}

binary_exists() {
  local item

  for item in "$@"; do
    [ -n "$item" ] || continue
    case "$item" in
      */*) [ -x "$item" ] && return 0 ;;
      *) command -v "$item" >/dev/null 2>&1 && return 0 ;;
    esac
  done

  return 1
}

uci_section_count_from() {
  printf '%s\n' "$1" | sed -n "s/^$2\\.\\([^.=]*\\)=.*/\\1/p" | sort -u | wc -l | tr -d ' '
}

uci_has_any_option_from() {
  local data="$1" config="$2" option
  shift 2

  for option in "$@"; do
    [ -n "$option" ] || continue
    printf '%s\n' "$data" | grep -Eq "^$config\\.[^.]*\\.$option=['\"]?[^'\"]+" && return 0
  done

  return 1
}

menu_url() {
  local token="$1"
  local file=""
  local route=""

  for file in /usr/share/luci/menu.d/*.json; do
    [ -r "$file" ] || continue
    grep -qi "$token" "$file" || continue
    route="$(sed -n 's/.*"\(admin\/[^"]*'"$token"'[^"]*\)".*/\1/ip' "$file" | head -n 1)"
    [ -n "$route" ] && {
      printf '/cgi-bin/luci/%s' "$route"
      return 0
    }
  done

  return 1
}

provider_routing_mode() {
  local id="$1" mode="$2"

  case "$id:$mode" in
    ssclash:rule|ssclash:rules|ssclash:Rule|ssclash:Rules) printf 'rules'; return ;;
    ssclash:global|ssclash:Global|ssclash:GLOBAL) printf 'global'; return ;;
    ssclash:direct|ssclash:Direct|ssclash:DIRECT) printf 'direct'; return ;;
    podkop:global|podkop:Global|podkop:GLOBAL|netshift:global|netshift:Global|netshift:GLOBAL) printf 'global'; return ;;
    podkop:selective|podkop:Selective|podkop:SELECTIVE|netshift:selective|netshift:Selective|netshift:SELECTIVE) printf 'selective'; return ;;
  esac

  case "$id" in
    podkop)
      uci_has_any_option_from "$SNAPSHOT_UCI_PODKOP" podkop community_lists user_domains user_subnets remote_domain_lists remote_subnet_lists && printf 'selective' && return
      ;;
    netshift)
      uci_has_any_option_from "$SNAPSHOT_UCI_NETSHIFT" netshift community_lists user_domains user_subnets routes rules include_domains include_subnets && printf 'selective' && return
      ;;
  esac

  printf 'unknown'
}

provider_configuration_state() {
  local id="$1" configured="$2"

  [ "$configured" = "1" ] || {
    printf 'missing'
    return
  }

  case "$id" in
    podkop)
      uci_has_any_option_from "$SNAPSHOT_UCI_PODKOP" podkop proxy_string outbound_json selector_proxy_links urltest_proxy_links community_lists user_domains user_subnets && printf 'ready' || printf 'unknown'
      ;;
    netshift)
      uci_has_any_option_from "$SNAPSHOT_UCI_NETSHIFT" netshift proxy_string outbound_json server subscription url routes rules include_domains include_subnets && printf 'ready' || printf 'unknown'
      ;;
    ssclash)
      if [ -n "$SNAPSHOT_SSCLASH_SETTINGS" ] || [ -s /opt/clash/config.yaml ]; then
        printf 'ready'
      else
        printf 'missing'
      fi
      ;;
    *)
      printf 'unknown'
      ;;
  esac
}

read_limited_file() {
  local file="$1"

  [ -r "$file" ] || return 0
  dd if="$file" bs=8192 count=2 2>/dev/null || true
}

protocol_from_text() {
  local data="$1"
  local type="" security="" transport="" display="" count=1

  printf '%s\n' "$data" | grep -Eiq 'hysteria2|hy2' && type="hysteria2"
  [ -n "$type" ] || printf '%s\n' "$data" | grep -Eiq 'shadowsocks|ss://' && type="shadowsocks"
  [ -n "$type" ] || printf '%s\n' "$data" | grep -Eiq 'trojan' && type="trojan"
  [ -n "$type" ] || printf '%s\n' "$data" | grep -Eiq 'amneziawg|awg' && type="amneziawg"
  [ -n "$type" ] || printf '%s\n' "$data" | grep -Eiq 'wireguard' && type="wireguard"
  [ -n "$type" ] || printf '%s\n' "$data" | grep -Eiq 'vless|vless://' && type="vless"
  [ -n "$type" ] || printf '%s\n' "$data" | grep -Eiq 'vmess|vmess://' && type="vmess"

  printf '%s\n' "$data" | grep -Eiq 'reality' && security="reality"
  [ -n "$security" ] || printf '%s\n' "$data" | grep -Eiq 'tls' && security="tls"

  printf '%s\n' "$data" | grep -Eiq 'xhttp' && transport="xhttp"
  [ -n "$transport" ] || printf '%s\n' "$data" | grep -Eiq 'grpc' && transport="grpc"
  [ -n "$transport" ] || printf '%s\n' "$data" | grep -Eiq 'websocket|ws' && transport="ws"
  [ -n "$transport" ] || printf '%s\n' "$data" | grep -Eiq 'tcp' && transport="tcp"

  case "$type" in
    vless) display="VLESS" ;;
    vmess) display="VMess" ;;
    hysteria2) display="Hysteria2" ;;
    shadowsocks) display="Shadowsocks" ;;
    trojan) display="Trojan" ;;
    amneziawg) display="AmneziaWG" ;;
    wireguard) display="WireGuard" ;;
    *) display="Not determined" ;;
  esac

  case "$security" in
    reality) display="$display · Reality" ;;
    tls) display="$display · TLS" ;;
  esac

  case "$transport" in
    xhttp) display="$display · XHTTP" ;;
    grpc) display="$display · gRPC" ;;
    ws) display="$display · WebSocket" ;;
    tcp) display="$display · TCP" ;;
  esac

  printf '%s|%s|%s|%s|%s' "$type" "$security" "$transport" "$display" "$count"
}

emit_protocol() {
  local protocol="$1" type security transport display count

  type="$(printf '%s' "$protocol" | awk -F '|' '{print $1}')"
  security="$(printf '%s' "$protocol" | awk -F '|' '{print $2}')"
  transport="$(printf '%s' "$protocol" | awk -F '|' '{print $3}')"
  display="$(printf '%s' "$protocol" | awk -F '|' '{print $4}')"
  count="$(printf '%s' "$protocol" | awk -F '|' '{print $5}')"

  printf '{"type":'
  json_null_or_string "$type"
  printf ',"security":'
  json_null_or_string "$security"
  printf ',"transport":'
  json_null_or_string "$transport"
  printf ',"display":'
  json_string "${display:-Not determined}"
  printf ',"profile_count":'
  json_number "$count"
  printf '}'
}

last_check_result() {
  local health="$1" traffic_state="$2"

  case "$health:$traffic_state" in
    ok:active) printf 'success' ;;
    error:*) printf 'error' ;;
    degraded:*|*:unknown) printf 'warning' ;;
    *) printf 'unknown' ;;
  esac
}

emit_last_check() {
  local result="$1" source="$2"

  printf '{"timestamp":'
  json_number "$SNAPSHOT_NOW"
  printf ',"result":'
  json_string "$result"
  printf ',"source":'
  json_string "$source"
  printf '}'
}

error_message() {
  case "$1" in
    routing_not_active) printf 'VPN routing is not active' ;;
    traffic_unverified) printf 'VPN traffic could not be verified' ;;
    core_not_running) printf 'SSClash core is not running' ;;
    nft_table_missing) printf 'SSClash nft table is missing' ;;
    policy_routing_invalid) printf 'SSClash policy routing validation failed' ;;
    forwarding_invalid) printf 'SSClash forwarding validation failed' ;;
    settings_missing) printf 'SSClash settings are missing' ;;
    mode_invalid) printf 'SSClash mode settings are invalid' ;;
    backend_stopped) printf 'Backend is not running' ;;
    service_stopped) printf 'Application is not active' ;;
    config_missing) printf 'Configuration is missing' ;;
    core_missing) printf 'Mihomo core is missing' ;;
    *) printf 'Status requires attention' ;;
  esac
}

emit_errors() {
  local code="$1" severity="$2"

  if [ -z "$code" ]; then
    printf '[]'
    return
  fi

  printf '[{"code":'
  json_string "$code"
  printf ',"message":'
  json_string "$(error_message "$code")"
  printf ',"severity":'
  json_string "$severity"
  printf '}]'
}

application_state_from_service() {
  case "$1" in
    running) printf 'active' ;;
    not_configured|stopped|starting) printf 'inactive' ;;
    *) printf 'unknown' ;;
  esac
}

provider_json() {
  local id="$1" name="$2" installed="$3" version="$4" configured="$5" enabled="$6"
  local service_state="$7" traffic_state="$8" health="$9" reason="${10}" mode="${11}" routing_mode="${12}"
  local configuration_state="${13}" backend="${14}" manage_url="${15}" ui_installed="${16}" active_items="${17}"
  local service_name="${18}" effective_running="${19}" controller_running="${20}" backend_running="${21}"
  local routing_active="${22}" routing_mechanism="${23}" routing_table="${24}" runtime_owner="${25}"
  local protocol="${26}" check_source="${27:-runtime_snapshot}" application_state="" application_reason="" error_severity="warning" check_result=""

  application_state="$(application_state_from_service "$service_state")"
  application_reason="$reason"
  [ "$health" = "error" ] && error_severity="error"
  check_result="$(last_check_result "$health" "$traffic_state")"

  printf '{'
  printf '"id":'; json_string "$id"; printf ','
  printf '"name":'; json_string "$name"; printf ','
  printf '"installed":'; json_bool "$installed"; printf ','
  printf '"version":'; json_null_or_string "$version"; printf ','
  printf '"configured":'; json_bool "$configured"; printf ','
  printf '"enabled":'; json_bool "$enabled"; printf ','
  printf '"application_state":'; json_string "$application_state"; printf ','
  printf '"application_reason":'; json_null_or_string "$application_reason"; printf ','
  printf '"protocol":'; emit_protocol "$protocol"; printf ','
  printf '"service_state":'; json_string "$service_state"; printf ','
  printf '"traffic_state":'; json_string "$traffic_state"; printf ','
  printf '"traffic_reason":'; json_null_or_string "$reason"; printf ','
  printf '"last_check":'; emit_last_check "$check_result" "$check_source"; printf ','
  printf '"errors":'; emit_errors "$reason" "$error_severity"; printf ','
  printf '"health":'; json_string "$health"; printf ','
  printf '"reason":'; json_null_or_string "$reason"; printf ','
  printf '"mode":'; json_null_or_string "$mode"; printf ','
  printf '"routing_mode":'; json_string "$routing_mode"; printf ','
  printf '"configuration_state":'; json_string "$configuration_state"; printf ','
  printf '"backend":'; json_null_or_string "$backend"; printf ','
  printf '"manage_url":'; json_null_or_string "$manage_url"; printf ','
  printf '"ui_installed":'; json_bool "$ui_installed"; printf ','
  printf '"active_items":'; json_number "$active_items"; printf ','
  printf '"service":{"name":'; json_null_or_string "$service_name"; printf ',"running":'; json_bool "$effective_running"; printf ',"enabled":'; json_bool "$enabled"; printf ',"controller_running":'; json_bool "$controller_running"; printf '},'
  printf '"backend_info":{"name":'; json_null_or_string "$backend"; printf ',"running":'; json_bool "$backend_running"; printf ',"owner":'; json_null_or_string "$runtime_owner"; printf '},'
  printf '"routing":{"active":'; json_bool "$routing_active"; printf ',"mechanism":'; json_null_or_string "$routing_mechanism"; printf ',"table":'; json_null_or_string "$routing_table"; printf '}'
  printf '}'
}

provider_registry() {
  printf '%s\n' podkop ssclash netshift
}

singbox_running() {
  service_running sing-box || process_running '(^|[ /])sing-box([ ]|$)'
}

podkop_provider() {
  local installed=0 ui=0 controller=0 enabled=0 backend=0 configured=0 route=0 effective=0
  local version="" count=0 mode="" routing_mode="unknown" configuration_state="unknown"
  local service_state="unknown" traffic_state="unknown" health="unknown" reason="" url="" protocol=""

  package_any podkop luci-app-podkop || exists_path /etc/init.d/podkop || exists_path /etc/config/podkop || return 1
  installed=1
  package_installed luci-app-podkop && ui=1
  service_running podkop && controller=1
  service_enabled podkop && enabled=1
  singbox_running && backend=1
  [ "$(uci_section_count_from "$SNAPSHOT_UCI_PODKOP" podkop)" -gt 0 ] && configured=1
  [ "$SNAPSHOT_PODKOP_ROUTING" = "1" ] && route=1
  if [ "$backend" = "1" ] || [ "$controller" = "1" ]; then
    effective=1
  fi
  version="$(first_package_version podkop luci-app-podkop)"
  count="$(uci_section_count_from "$SNAPSHOT_UCI_PODKOP" podkop)"
  mode="$(printf '%s\n' "$SNAPSHOT_UCI_PODKOP" | sed -n "s/^podkop\\.[^.]*\\.\\(mode\\|routing_mode\\|proxy_mode\\)=['\"]*\\([^'\"]*\\)['\"]*$/\\2/p" | head -n 1)"
  routing_mode="$(provider_routing_mode podkop "$mode")"
  configuration_state="$(provider_configuration_state podkop "$configured")"
  protocol="$(protocol_from_text "$(printf '%s\n' "$SNAPSHOT_UCI_PODKOP"; read_limited_file /etc/sing-box/config.json)")"
  [ "$ui" = "1" ] && url="$(menu_url podkop)"

  if [ "$backend" = "1" ] && [ "$route" = "1" ]; then
    service_state="running"; traffic_state="active"; health="ok"
  elif [ "$backend" = "1" ]; then
    service_state="running"; traffic_state="inactive"; health="degraded"; reason="routing_not_active"
  elif [ "$controller" = "1" ]; then
    service_state="starting"; traffic_state="inactive"; health="degraded"; reason="backend_stopped"
  else
    service_state="stopped"; traffic_state="inactive"; health="degraded"; reason="service_stopped"
  fi

  if [ "$configured" = "0" ]; then
    configuration_state="missing"
    service_state="not_configured"
    traffic_state="inactive"
    health="degraded"
    reason="config_missing"
  fi

  provider_json podkop Podkop "$installed" "$version" "$configured" "$enabled" "$service_state" "$traffic_state" "$health" "$reason" "$mode" "$routing_mode" "$configuration_state" sing-box "$url" "$ui" "$count" podkop "$effective" "$controller" "$backend" "$route" nftables PodkopTable podkop "$protocol"
}

netshift_owner_evidence() {
  [ -n "$SNAPSHOT_UCI_NETSHIFT" ] || exists_path /etc/init.d/netshift || exists_path /usr/bin/netshift || package_any netshift luci-app-netshift
}

netshift_provider() {
  local installed=0 ui=0 controller=0 enabled=0 backend=0 configured=0 route=0 effective=0 owner_evidence=0
  local version="" count=0 mode="" routing_mode="unknown" configuration_state="unknown"
  local service_state="unknown" traffic_state="unknown" health="unknown" reason="" url="" protocol=""

  netshift_owner_evidence || return 1
  owner_evidence=1
  installed=1
  package_installed luci-app-netshift && ui=1
  service_running netshift && controller=1
  service_enabled netshift && enabled=1
  singbox_running && backend=1
  [ "$(uci_section_count_from "$SNAPSHOT_UCI_NETSHIFT" netshift)" -gt 0 ] && configured=1
  [ "$SNAPSHOT_NETSHIFT_ROUTING" = "1" ] && route=1
  if [ "$controller" = "1" ] || [ "$route" = "1" ] || { [ "$backend" = "1" ] && [ "$owner_evidence" = "1" ]; }; then
    effective=1
  fi
  version="$(first_package_version netshift luci-app-netshift)"
  count="$(uci_section_count_from "$SNAPSHOT_UCI_NETSHIFT" netshift)"
  mode="$(printf '%s\n' "$SNAPSHOT_UCI_NETSHIFT" | sed -n "s/^netshift\\.[^.]*\\.\\(mode\\|routing_mode\\|proxy_mode\\)=['\"]*\\([^'\"]*\\)['\"]*$/\\2/p" | head -n 1)"
  routing_mode="$(provider_routing_mode netshift "$mode")"
  configuration_state="$(provider_configuration_state netshift "$configured")"
  protocol="$(protocol_from_text "$(printf '%s\n' "$SNAPSHOT_UCI_NETSHIFT"; read_limited_file /etc/sing-box/config.json)")"
  [ "$ui" = "1" ] && url="$(menu_url netshift)"

  if [ "$configured" = "0" ]; then
    service_state="not_configured"; traffic_state="inactive"; health="degraded"; reason="config_missing"
  elif [ "$backend" = "1" ] && [ "$route" = "1" ]; then
    service_state="running"; traffic_state="active"; health="ok"
  elif [ "$backend" = "1" ]; then
    service_state="running"; traffic_state="inactive"; health="degraded"; reason="routing_not_active"
  elif [ "$controller" = "1" ]; then
    service_state="starting"; traffic_state="inactive"; health="degraded"; reason="backend_stopped"
  else
    service_state="stopped"; traffic_state="inactive"; health="degraded"; reason="service_stopped"
  fi

  provider_json netshift NetShift "$installed" "$version" "$configured" "$enabled" "$service_state" "$traffic_state" "$health" "$reason" "$mode" "$routing_mode" "$configuration_state" sing-box "$url" "$ui" "$count" netshift "$effective" "$controller" "$backend" "$route" nftables NetShiftTable netshift "$protocol"
}

ssclash_owner_evidence() {
  package_installed luci-app-ssclash || exists_path /etc/init.d/clash || [ -n "$SNAPSHOT_SSCLASH_SETTINGS" ] || [ -s /opt/clash/config.yaml ]
}

ssclash_core_running() {
  service_running clash || process_running '(^|[[:space:]])/opt/clash/bin/clash([[:space:]]|$)'
}

ssclash_setting() {
  local key="$1"

  printf '%s\n' "$SNAPSHOT_SSCLASH_SETTINGS" | sed -n "s/^${key}=//p" | tail -n 1 | tr -d '"'"'"
}

ssclash_mode_display() {
  local proxy="$1" iface="$2" proxy_label="" iface_label=""

  case "$proxy" in
    tproxy) proxy_label="TProxy" ;;
    tun) proxy_label="TUN" ;;
    mixed) proxy_label="Mixed" ;;
    *) proxy_label="" ;;
  esac

  case "$iface" in
    exclude) iface_label="Исключения" ;;
    explicit) iface_label="Выбранные интерфейсы" ;;
    *) iface_label="" ;;
  esac

  [ -n "$proxy_label" ] && [ -n "$iface_label" ] && {
    printf '%s · %s' "$proxy_label" "$iface_label"
    return
  }

  printf 'Не определён'
}

ssclash_rules_check() {
  local check="$1"

  [ -x /opt/clash/bin/clash-rules ] || return 1
  /opt/clash/bin/clash-rules "$check" >/dev/null 2>&1
}

ssclash_provider() {
  local installed=0 ui=0 controller=0 enabled=0 core=0 backend=0 configured=0 route=0 effective=0
  local nft_table=0 policy_valid=0 forward_valid=1 forward_required=0 mode_valid=0
  local version="" count=0 proxy_mode="" interface_mode="" mode_display="" mode="" routing_mode="unknown" configuration_state="unknown"
  local service_name="clash" service_state="unknown" traffic_state="unknown" health="unknown" reason="" url="" protocol=""

  ssclash_owner_evidence || return 1
  installed=1
  package_installed luci-app-ssclash && ui=1
  service_running clash && controller=1
  service_enabled clash && enabled=1
  binary_exists /opt/clash/bin/clash && core=1
  ssclash_core_running && backend=1
  if [ -n "$SNAPSHOT_SSCLASH_SETTINGS" ] || [ -s /opt/clash/config.yaml ]; then
    configured=1
  fi
  [ "$SNAPSHOT_SSCLASH_NFT" = "1" ] && nft_table=1
  ssclash_rules_check validate_policy && policy_valid=1
  proxy_mode="$(ssclash_setting PROXY_MODE)"
  interface_mode="$(ssclash_setting INTERFACE_MODE)"
  case "$proxy_mode" in
    tproxy) forward_required=0 ;;
    tun|mixed) forward_required=1 ;;
    *) forward_required=0 ;;
  esac
  case "$proxy_mode:$interface_mode" in
    tproxy:exclude|tproxy:explicit|tun:exclude|tun:explicit|mixed:exclude|mixed:explicit) mode_valid=1 ;;
  esac
  if [ "$forward_required" = "1" ]; then
    forward_valid=0
    ssclash_rules_check validate_forward && forward_valid=1
  fi
  [ "$backend" = "1" ] && [ "$nft_table" = "1" ] && [ "$policy_valid" = "1" ] && [ "$forward_valid" = "1" ] && route=1
  if [ "$backend" = "1" ] || [ "$controller" = "1" ]; then
    effective=1
  fi
  version="$(first_package_version luci-app-ssclash clash)"
  count=1
  mode_display="$(ssclash_mode_display "$proxy_mode" "$interface_mode")"
  mode="$mode_display"
  [ "$mode_valid" = "1" ] && routing_mode="$proxy_mode"
  configuration_state="$(provider_configuration_state ssclash "$configured")"
  protocol="|||Not determined|1"
  [ "$ui" = "1" ] && url="$(menu_url ssclash)"

  if [ "$configured" = "0" ]; then
    service_state="not_configured"; traffic_state="inactive"; health="degraded"; reason="config_missing"
  elif [ "$core" = "0" ]; then
    service_state="stopped"; traffic_state="inactive"; health="error"; reason="core_missing"
  elif [ "$backend" = "0" ]; then
    service_state="stopped"; traffic_state="inactive"; health="degraded"; reason="core_not_running"
  elif [ -n "$SNAPSHOT_SSCLASH_SETTINGS" ] && [ "$mode_valid" = "0" ]; then
    service_state="running"; traffic_state="unknown"; health="degraded"; reason="mode_invalid"
  elif [ -z "$SNAPSHOT_SSCLASH_SETTINGS" ]; then
    service_state="running"; traffic_state="unknown"; health="degraded"; reason="settings_missing"
  elif [ "$nft_table" = "0" ]; then
    service_state="running"; traffic_state="inactive"; health="degraded"; reason="nft_table_missing"
  elif [ "$policy_valid" = "0" ]; then
    service_state="running"; traffic_state="inactive"; health="degraded"; reason="policy_routing_invalid"
  elif [ "$forward_valid" = "0" ]; then
    service_state="running"; traffic_state="degraded"; health="degraded"; reason="forwarding_invalid"
  elif [ "$route" = "1" ]; then
    service_state="running"; traffic_state="active"; health="ok"
  else
    service_state="running"; traffic_state="unknown"; health="degraded"; reason="traffic_unverified"
  fi

  provider_json ssclash SSClash "$installed" "$version" "$configured" "$enabled" "$service_state" "$traffic_state" "$health" "$reason" "$mode" "$routing_mode" "$configuration_state" Mihomo "$url" "$ui" "$count" "$service_name" "$effective" "$controller" "$backend" "$route" ssclash_runtime_validation clash ssclash "$protocol" ssclash_runtime_validation
}

status() {
  local providers="" item="" provider="" installed_count=0 running_count=0 active_count=0 state="empty" conflict=false

  collect_snapshot

  for provider in $(provider_registry); do
    item="$("${provider}_provider" 2>/dev/null)" || item=""
    [ -n "$item" ] || continue
    providers="${providers:+$providers,}$item"
    installed_count=$((installed_count + 1))
    printf '%s' "$item" | grep -q '"service_state":"running"' && running_count=$((running_count + 1))
    printf '%s' "$item" | grep -q '"traffic_state":"active"' && active_count=$((active_count + 1))
  done

  if [ "$running_count" -gt 1 ]; then
    state="conflict"
    conflict=true
  elif [ "$installed_count" -eq 0 ]; then
    state="empty"
  elif [ "$active_count" -gt 0 ]; then
    state="running"
  elif printf '%s' "$providers" | grep -q '"traffic_state":"unknown"'; then
    state="unknown"
  elif printf '%s' "$providers" | grep -q '"health":"degraded"'; then
    state="degraded"
  elif printf '%s' "$providers" | grep -q '"health":"error"'; then
    state="degraded"
  elif printf '%s' "$providers" | grep -q '"health":"unknown"'; then
    state="unknown"
  else
    state="stopped"
  fi

  printf '{"overall":{"state":'
  json_string "$state"
  printf ',"installed_count":%s,"running_count":%s,"active_count":%s,"conflict":%s},"providers":[%s]}\n' "$installed_count" "$running_count" "$active_count" "$conflict" "$providers"
}

case "$1" in
  list)
    printf '{"status":{}}\n'
    ;;
  call)
    [ "$2" = "status" ] && status || printf '{"error":"Method not found"}\n'
    ;;
  *)
    printf '{"status":{}}\n'
    ;;
esac
